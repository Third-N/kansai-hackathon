# Supabase を使うときだけ設定する。無ければ localStorage 実装で動く。
# 値は Supabase の Project Settings → API から。anon key はブラウザに出るもので、
# 秘密鍵（service_role）は絶対にここに書かない。
NEXT_PUBLIC_SUPABASE_URL=
# 新形式（sb_publishable_...）でも旧形式（JWT）でもよい
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# デモモードの合図。未設定なら「みちゆき」
NEXT_PUBLIC_DEMO_CODE=

# 匿名ログインを試すか。off にすると signInAnonymously を叩かない
NEXT_PUBLIC_SUPABASE_ANON_AUTH=on

# Geoapify のAPIキー。地図の背景画像と、端末内の900件で見つからない
# 行き先のオンライン検索に使う。無くても端末内検索は利用できる。
# 地図は今まで通り、点と線だけの図へフォールバックする。
# https://www.geoapify.com/ で無料登録（カード不要）すれば取れる
NEXT_PUBLIC_GEOAPIFY_KEY=
